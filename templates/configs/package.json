{
  "devDependencies": {
    "@babel/preset-env": "^7.17.10",
    "@plentiful/theme-standards": "github:Plentiful-Commerce/theme-standards#v0.2.0",
    "@symfony/webpack-encore": "^2.1.0",
    "autoprefixer": "^10.4.2",
    "core-js": "^3.22.5",
    "file-loader": "^6.0.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.5",
    "postcss-import": "^14.0.2",
    "postcss-loader": "^6.0.0",
    "postcss-preset-env": "^7.7.1",
    "regenerator-runtime": "^0.13.2",
    "sass": "^1.43.4",
    "sass-loader": "^12.4.0",
    "tailwindcss": "^3.3.6",
    "webpack-notifier": "^1.6.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "theme-version": "[THEME_NAME] [VERSION]",
  "scripts": {
    "dev-server": "encore dev-server",
    "dev": "concurrently \" npm run watch \" \" npm run shopify:dev\"",
    "shopify:dev": "shopify theme dev --store=[STORE_ID]",
    "watch": "encore dev --watch",
    "build": "encore production --progress",
    "lint": "eslint 'src/**/*.js'",
    "lint:css": "stylelint 'src/**/*.{css,scss}' --allow-empty-input",
    "lint:liquid": "shopify theme check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pc-lint": "pc-lint",
    "check": "npm run lint && pc-lint --warn",
    "prepare": "husky"
  },
  "prettier": "@plentiful/theme-standards/prettier",
  "dependencies": {
    "@babel/plugin-transform-classes": "^7.16.7",
    "babel-plugin-transform-builtin-classes": "^0.6.1",
    "concurrently": "^9.1.2",
    "eslint-webpack-plugin": "^6.0.0",
    "imagemin-webp-webpack-plugin": "^3.3.1"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  }
}
