{
  "name": "@plentiful/theme-standards",
  "version": "0.2.0",
  "description": "Canonical lint/format/Theme Check configs and the custom pc-lint checks for Plentiful Commerce Shopify theme repos.",
  "type": "module",
  "bin": {
    "pc-lint": "./scripts/pc-lint.mjs",
    "theme-check-changed": "./scripts/theme-check-changed.mjs",
    "pc-design-tokens": "./scripts/pc-design-tokens.mjs",
    "pc-repo-check": "./scripts/pc-repo-check.mjs",
    "pc-pr-template": "./scripts/pc-pr-template.mjs",
    "pc-pr-body-check": "./scripts/pc-pr-body-check.mjs",
    "pc-pre-commit": "./scripts/pc-pre-commit.sh"
  },
  "exports": {
    "./prettier": "./prettier.json",
    "./eslint": "./eslint/index.mjs",
    "./stylelint": "./stylelint/index.json",
    "./theme-check": "./theme-check/index.yml",
    "./rules/liquid-checks.mjs": "./rules/liquid-checks.mjs",
    "./package.json": "./package.json",
    "./lint-staged": "./lint-staged/index.mjs"
  },
  "files": [
    "prettier.json",
    "eslint",
    "stylelint",
    "lint-staged",
    "theme-check",
    "rules",
    "templates",
    "scripts",
    "CODING-STANDARDS.md",
    "REPO-GUIDE.md"
  ],
  "dependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@eslint/js": "10.0.1",
    "@shopify/prettier-plugin-liquid": "1.11.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "release": "node scripts/release.mjs"
  }
}
